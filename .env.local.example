NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STAYLINK_ADMIN_API_TOKEN=change-this-admin-token

NEXT_PUBLIC_STAYLINK_DEFAULT_ACCOMMODATION_ID=baebang-alps

# Toss Payments test/live keys. Server key must stay server-only.
TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_toss_client_key
TOSS_PAYMENTS_SECRET_KEY=test_sk_your_toss_secret_key

# Manual bank transfer instructions shown to customers.
PENBATV_BANK_NAME=은행명
PENBATV_BANK_ACCOUNT_NO=000-0000-0000-00
PENBATV_BANK_HOLDER_NAME=펜바TV
PENBATV_BANK_DEPOSIT_DUE_HOURS=24
